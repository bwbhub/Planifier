# Planifier — variables d'environnement.
# Copier vers apps/<app>/.env.local (jamais commité). Aucune valeur secrète ici.
# Chaque app valide ses variables dans son env.ts (Zod) et refuse de démarrer si elles sont invalides.

# --- apps/web ---
# Optionnel. Port d'écoute (défaut 3000).
PORT=3000
# Obligatoire. Origine de l'API vue depuis le serveur web (réseau interne), cible du proxy /rpc.
API_INTERNAL_URL=http://localhost:3001

# --- apps/api ---
# Copier vers apps/api/.env.local. Obligatoire. development | test | production (fixé par le script dev).
NODE_ENV=development
# Optionnel. Port d'écoute (défaut 3001).
PORT=3001
# Obligatoire. Base lue par l'API et Better Auth (même valeur que DATABASE_URL de packages/db).
DATABASE_URL=postgresql://planifier:planifier@localhost:5433/planifier
# Obligatoire, secret, distinct par environnement. Au moins 32 caractères ; générer avec `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Obligatoire. Origine publique du web (le navigateur n'appelle que lui) ; https en production.
BETTER_AUTH_URL=http://localhost:3000

# --- apps/web, tests E2E (`pnpm test:e2e`, lus par apps/web/e2e/env.ts) ---
# Obligatoire. Base dédiée aux tests, nom en `_test` (refusé sinon) : les parcours y créent des comptes.
# DATABASE_URL=postgresql://planifier:planifier@localhost:5433/planifier_test
# Optionnel (posé par GitHub Actions). true : `test.only` refusé, rapport au format GitHub.
# CI=false

# --- packages/db (client, migrations, seed) ---
# Copier vers packages/db/.env.local. Les deux sont obligatoires. En local, c'est la même URL (docker-compose.yml).
# Avec Neon : DATABASE_URL = connexion poolée (hôte « -pooler »), pour le client ;
# DATABASE_URL_UNPOOLED = connexion directe, pour les migrations (`prisma migrate`).
DATABASE_URL=postgresql://planifier:planifier@localhost:5433/planifier
DATABASE_URL_UNPOOLED=postgresql://planifier:planifier@localhost:5433/planifier
