{
  "name": "@planifier/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env.local --watch --import tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@orpc/server": "catalog:",
    "@planifier/api": "workspace:*",
    "@planifier/auth": "workspace:*",
    "@planifier/constants": "workspace:*",
    "@planifier/db": "workspace:*",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@planifier/api-contract": "workspace:*",
    "@planifier/eslint-config": "workspace:*",
    "@planifier/mails": "workspace:*",
    "@planifier/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
