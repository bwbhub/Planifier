# Configuration de la base de données
DATABASE_URL="postgresql://user:password@localhost:5432/planifier"

# JWT Secret
JWT_SECRET="your_jwt_secret_key_change_me_in_production"

# Port du serveur
PORT=4000

# Configuration SMTP pour l'envoi d'emails
# Pour le développement, vous pouvez utiliser Mailtrap (https://mailtrap.io)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_mailtrap_username"
SMTP_PASS="your_mailtrap_password"
SMTP_FROM="Planifier <noreply@planifier.app>"

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL="http://localhost:3000"

# Environnement
NODE_ENV="development"
