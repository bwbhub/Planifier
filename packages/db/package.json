{
  "name": "@planifier/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "DATABASE_URL_UNPOOLED=postgresql://unused@localhost/unused prisma generate",
    "validate": "DATABASE_URL_UNPOOLED=postgresql://unused@localhost/unused prisma validate",
    "migrate:dev": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file-if-exists=.env.local --import tsx src/seed/index.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "format": "DATABASE_URL_UNPOOLED=postgresql://unused@localhost/unused prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@planifier/eslint-config": "workspace:*",
    "@planifier/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
