// Schéma de Planifier v2 (PostgreSQL, Prisma 7). Aucune fonction propre à l'hébergeur (ADR 0005).
// Conventions : tables et colonnes en snake_case via @map, ids uuid v7 (triables, pagination par curseur).
// Les enums sont les miroirs de `@planifier/constants` : toute modification se fait des deux côtés.
// Annotation `/// @pii <catégorie> <rétention>` : donnée personnelle, jamais dans les journaux.
// E-mails : toujours en minuscules (contrainte CHECK posée dans la migration, Prisma ne sait pas l'exprimer) ;
// l'unicité est donc insensible à la casse. Normaliser à la frontière (Zod) avant d'écrire.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôle dans un événement. OWNER crée et décide ; ORGANIZER invite et modifie ; GUEST voit et propose.
enum EventRole {
  OWNER
  ORGANIZER
  GUEST

  @@map("event_role")
}

/// Réponse d'un participant. Seules GOING et MAYBE placent l'événement dans l'agenda.
enum ParticipantStatus {
  GOING
  MAYBE
  NOT_GOING
  PENDING

  @@map("participant_status")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("invite_status")
}

/// Proposition d'un invité, validée par un organisateur.
enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("proposal_status")
}

enum NotificationType {
  INVITE_RECEIVED
  INVITE_ACCEPTED
  EVENT_UPDATED
  EVENT_IMPORTANT_FIELD_CHANGED
  EVENT_IMPORTANT_COMMENT
  PROPOSAL_RECEIVED
  PROPOSAL_APPROVED
  TASK_ASSIGNED
  TASK_REMINDER
  TASK_NUDGE

  @@map("notification_type")
}

/// Rôle dans un Espace. Membres égaux par défaut (ADR 0009).
enum SpaceRole {
  OWNER
  MEMBER

  @@map("space_role")
}

/// Module activable à la carte, par utilisateur et par Espace.
enum AppModule {
  TODO
  AGENDA
  EVENTS

  @@map("app_module")
}

// ---------------------------------------------------------------------------
// Utilisateurs
// ---------------------------------------------------------------------------

/// Les identifiants de connexion (mot de passe, sessions) appartiennent à Better Auth (ADR 0004).
model User {
  id             String      @id @default(uuid(7))
  /// @pii identité durée-du-compte
  email          String      @unique
  /// @pii identité durée-du-compte
  name           String?
  /// @pii identité durée-du-compte
  avatarUrl      String?     @map("avatar_url")
  preferredTheme String?     @map("preferred_theme")
  /// Modules activés par cet utilisateur pour son espace personnel.
  modules        AppModule[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  spaces              SpaceMember[]
  ownedEvents         Event[]            @relation("EventOwner")
  eventParticipations EventParticipant[]
  sentInvites         Invite[]           @relation("InviteSender")
  receivedInvites     Invite[]           @relation("InviteReceiver")
  madeProposals       ProposedInvite[]   @relation("Proposer")
  notifications       Notification[]
  comments            Comment[]
  friends             Friendship[]       @relation("UserFriends")
  friendOf            Friendship[]       @relation("FriendOf")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Espaces (ADR 0009) : couple, colocation, vacances… une seule notion
// ---------------------------------------------------------------------------

model Space {
  id        String      @id @default(uuid(7))
  name      String
  /// Modules activés pour tout l'Espace.
  modules   AppModule[]
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  members SpaceMember[]
  /// Espace supprimé : ses événements deviennent personnels (SetNull), les participants gardent leur accès.
  events  Event[]

  @@map("spaces")
}

model SpaceMember {
  id       String    @id @default(uuid(7))
  role     SpaceRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  spaceId String @map("space_id")
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

// ---------------------------------------------------------------------------
// Événements
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(uuid(7))
  title       String
  description String?   @db.Text
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  coverUrl    String?   @map("cover_url")
  /// Teinte choisie par l'utilisateur (la valeur par défaut vient des tokens côté interface).
  color       String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Propriétaire. null : il a supprimé son compte ; un co-organisateur peut reprendre la propriété, sinon un job
  /// planifié supprime l'événement 48 h après `ownerLeftAt`. Le service de suppression de compte renseigne
  /// `ownerLeftAt` dans la même transaction que la suppression (la clé étrangère met `ownerId` à null).
  ownerId     String?   @map("owner_id")
  owner       User?     @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerLeftAt DateTime? @map("owner_left_at")
  /// null = événement personnel et privé (ADR 0009).
  spaceId     String?   @map("space_id")
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  participants    EventParticipant[]
  settings        EventSettings?
  invites         Invite[]
  proposedInvites ProposedInvite[]
  notifications   Notification[]
  comments        Comment[]

  @@index([spaceId, startDate])
  @@index([ownerId])
  @@index([startDate])
  @@index([ownerLeftAt])
  @@map("events")
}

model EventParticipant {
  id       String            @id @default(uuid(7))
  role     EventRole         @default(GUEST)
  status   ParticipantStatus @default(PENDING)
  joinedAt DateTime          @default(now()) @map("joined_at")

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_participants")
}

model EventSettings {
  id                 String  @id @default(uuid(7))
  /// Les invités peuvent voir qui vient.
  isGuestListVisible Boolean @default(true) @map("is_guest_list_visible")
  /// true : un invité invite directement ; false : il passe par une proposition.
  allowGuestInvite   Boolean @default(false) @map("allow_guest_invite")
  /// null = illimité.
  maxParticipants    Int?    @map("max_participants")

  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

// ---------------------------------------------------------------------------
// Invitations
// ---------------------------------------------------------------------------

/// Invitation officielle (envoyée par un organisateur, ou issue d'une proposition validée).
model Invite {
  id        String       @id @default(uuid(7))
  /// Jeton du lien d'accès.
  token     String       @unique
  /// L'invité n'a pas forcément de compte.
  /// @pii identité fin-de-l'événement
  email     String
  status    InviteStatus @default(PENDING)
  /// Rôle que la personne aura si elle accepte.
  role      EventRole    @default(GUEST)
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  eventId   String  @map("event_id")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId String  @map("inviter_id")
  inviter   User    @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  /// Renseigné si l'invité a déjà un compte.
  userId    String? @map("user_id")
  user      User?   @relation("InviteReceiver", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([inviterId])
  @@index([userId])
  @@map("invites")
}

model ProposedInvite {
  id             String         @id @default(uuid(7))
  /// @pii identité fin-de-l'événement
  suggestedEmail String?        @map("suggested_email")
  reason         String?
  status         ProposalStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  eventId    String @map("event_id")
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposerId String @map("proposer_id")
  proposer   User   @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([proposerId])
  @@map("proposed_invites")
}

// ---------------------------------------------------------------------------
// Notifications et commentaires
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid(7))
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  /// Contenu propre au type, validé par un schéma Zod versionné (`schemaVersion`) à l'écriture et à la lecture.
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  /// Destinataire.
  userId  String  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([eventId])
  @@map("notifications")
}

model Comment {
  id          String   @id @default(uuid(7))
  text        String   @db.Text
  /// Un commentaire important notifie les inscrits (CONTEXT.md).
  isImportant Boolean  @default(false) @map("is_important")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Amis (deviendra « Contact », voir CONTEXT.md)
// ---------------------------------------------------------------------------

model Friendship {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now()) @map("created_at")

  userId   String @map("user_id")
  user     User   @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId String @map("friend_id")
  friend   User   @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}
