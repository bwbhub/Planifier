// Schéma de Planifier v2 (PostgreSQL, Prisma 7). Aucune fonction propre à l'hébergeur (ADR 0005).
// Conventions : tables et colonnes en snake_case via @map, ids uuid v7 (triables, pagination par curseur).
// Les enums sont les miroirs de `@planifier/constants` : toute modification se fait des deux côtés.
// Annotation `/// @pii <catégorie> <rétention>` : donnée personnelle, jamais dans les journaux.
// E-mails : toujours en minuscules (contrainte CHECK posée dans la migration, Prisma ne sait pas l'exprimer) ;
// l'unicité est donc insensible à la casse. Normaliser à la frontière (Zod) avant d'écrire.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôle dans un événement. OWNER crée et décide ; ORGANIZER invite et modifie ; GUEST voit et propose.
enum EventRole {
  OWNER
  ORGANIZER
  GUEST

  @@map("event_role")
}

/// Réponse d'un participant. Seules GOING et MAYBE placent l'événement dans l'agenda.
enum ParticipantStatus {
  GOING
  MAYBE
  NOT_GOING
  PENDING

  @@map("participant_status")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("invite_status")
}

/// Proposition d'un invité, validée par un organisateur.
enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("proposal_status")
}

enum NotificationType {
  INVITE_RECEIVED
  INVITE_ACCEPTED
  EVENT_UPDATED
  EVENT_IMPORTANT_FIELD_CHANGED
  EVENT_IMPORTANT_COMMENT
  PROPOSAL_RECEIVED
  PROPOSAL_APPROVED
  TASK_ASSIGNED
  TASK_REMINDER
  TASK_NUDGE

  @@map("notification_type")
}

/// Rôle dans un Espace. Membres égaux par défaut (ADR 0009).
enum SpaceRole {
  OWNER
  MEMBER

  @@map("space_role")
}

/// Module activable à la carte, par utilisateur et par Espace.
enum AppModule {
  TODO
  AGENDA
  EVENTS

  @@map("app_module")
}

/// Thème préféré ; SYSTEM suit le réglage de l'appareil.
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK

  @@map("theme_preference")
}

// ---------------------------------------------------------------------------
// Utilisateurs
// ---------------------------------------------------------------------------

/// Compte. Champs lus et écrits par Better Auth (ADR 0004) : `name`, `email`, `emailVerified`, `avatarUrl`
/// (son champ `image`), `createdAt`, `updatedAt`. Les identifiants de connexion vivent dans `Account`.
model User {
  id             String          @id @default(uuid(7))
  /// @pii identité durée-du-compte
  email          String          @unique
  /// Nom affiché, obligatoire (exigé par Better Auth à l'inscription).
  /// @pii identité durée-du-compte
  name           String
  emailVerified  Boolean         @default(false) @map("email_verified")
  /// @pii identité durée-du-compte
  avatarUrl      String?         @map("avatar_url")
  preferredTheme ThemePreference @default(SYSTEM) @map("preferred_theme")
  /// Modules activés par cet utilisateur pour son espace personnel.
  modules        AppModule[]     @default([])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  spaces              SpaceMember[]
  createdSpaces       Space[]            @relation("SpaceCreator")
  createdSpaceInvites SpaceInvite[]      @relation("SpaceInviteCreator")
  todoLists           TodoList[]
  /// Tâches cochées par l'utilisateur (« Cochée par »).
  completedTasks      Task[]             @relation("TaskCompleter")
  ownedEvents         Event[]            @relation("EventOwner")
  eventParticipations EventParticipant[]
  sentInvites         Invite[]           @relation("InviteSender")
  receivedInvites     Invite[]           @relation("InviteReceiver")
  madeProposals       ProposedInvite[]   @relation("Proposer")
  notifications       Notification[]
  comments            Comment[]
  friends             Friendship[]       @relation("UserFriends")
  friendOf            Friendship[]       @relation("FriendOf")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentification (Better Auth, ADR 0004) : tables possédées par la bibliothèque, jamais écrites par l'API
// ---------------------------------------------------------------------------

/// Session ouverte, désignée par le jeton du cookie httpOnly.
model Session {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  /// Secret de session : jamais journalisé ni renvoyé par l'API.
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  /// @pii technique durée-de-la-session
  ipAddress String?  @map("ip_address")
  /// @pii technique durée-de-la-session
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Moyen de connexion d'un compte : `credential` (mot de passe haché) aujourd'hui, Google plus tard.
model Account {
  id                    String    @id @default(uuid(7))
  userId                String    @map("user_id")
  /// Identifiant chez le fournisseur (pour `credential` : l'id de l'utilisateur).
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  /// Secrets : jamais journalisés ni renvoyés par l'API.
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Hash du mot de passe (format Better Auth) ; jamais en clair.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un compte fournisseur ne se rattache qu'à un seul utilisateur.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Jeton à usage unique de Better Auth (vérification d'e-mail, réinitialisation de mot de passe).
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Espaces (ADR 0009) : couple, colocation, vacances… une seule notion
// ---------------------------------------------------------------------------

model Space {
  id                 String      @id @default(uuid(7))
  name               String
  /// Modules activés pour tout l'Espace.
  modules            AppModule[]
  /// false : un membre voit tous les éléments de l'Espace (CONTEXT.md). true : il ne voit que ce qui lui est partagé.
  restrictVisibility Boolean     @default(false) @map("restrict_visibility")
  version            Int         @default(1)
  /// Créateur, protégé tant qu'il est membre : personne ne le rétrograde ni ne le retire. null : parti, ou compte
  /// supprimé ; la protection s'arrête.
  createdById        String?     @map("created_by_id")
  createdBy          User?       @relation("SpaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  members   SpaceMember[]
  invites   SpaceInvite[]
  /// Espace supprimé : ses événements deviennent personnels (SetNull), les participants gardent leur accès.
  events    Event[]
  /// Listes partagées de l'Espace ; s'il est supprimé, elles redeviennent perso pour leur propriétaire (SetNull).
  todoLists TodoList[]

  @@index([createdById])
  @@map("spaces")
}

model SpaceMember {
  id       String    @id @default(uuid(7))
  role     SpaceRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  spaceId String @map("space_id")
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

/// Lien d'invitation à un Espace, créé par un propriétaire : à usage unique, à durée limitée. Le jeton n'est jamais
/// stocké, seulement son empreinte ; quiconque a un compte et le lien rejoint l'Espace.
model SpaceInvite {
  id        String   @id @default(uuid(7))
  /// Empreinte SHA-256 (hex) du jeton du lien.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  spaceId     String @map("space_id")
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById String @map("created_by_id")
  createdBy   User   @relation("SpaceInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([createdById])
  @@map("space_invites")
}

// ---------------------------------------------------------------------------
// Todo : listes perso et partagées, tâches, sous-tâches, récurrence (assignation à venir)
// ---------------------------------------------------------------------------

/// Liste de tâches : perso (seul son propriétaire la voit) ou partagée avec un Espace (`spaceId`).
model TodoList {
  id        String   @id @default(uuid(7))
  name      String
  /// Teinte de la maquette (`LIST_TINTS`, constants) : ensemble évolutif, validé par Zod en écriture et en lecture.
  tint      String   @default("general")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String  @map("owner_id")
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Liste partagée : tous les membres de l'Espace la voient et y écrivent, même si l'Espace restreint sa visibilité ;
  /// elle appartient à l'Espace (son créateur parti, elle y reste). null : liste perso, privée. Espace supprimé : la
  /// liste redevient perso pour son créateur (SetNull).
  spaceId String? @map("space_id")
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([ownerId])
  @@index([spaceId])
  @@map("todo_lists")
}

/// Tâche d'une liste : titre obligatoire, le reste facultatif. Cochée seulement par un geste de l'utilisateur ;
/// cocher une tâche ne coche pas ses sous-tâches, et inversement.
model Task {
  id               String    @id @default(uuid(7))
  title            String
  description      String?
  /// Jour d'échéance, sans heure.
  dueDate          DateTime? @map("due_date") @db.Date
  /// null : à faire.
  completedAt      DateTime? @map("completed_at")
  /// Qui a coché (« Cochée par »). null : à faire, ou compte supprimé depuis.
  completedById    String?   @map("completed_by_id")
  completedBy      User?     @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  /// Répétition (ADR 0017) : `{ schemaVersion, frequency, interval }`, validée par `@planifier/domain-recurrence` en
  /// écriture et en lecture. null : tâche non répétée.
  recurrence       Json?
  /// Jour depuis lequel la série compte (ADR 0017), posé à la première occurrence faite ; garde le 31 ou le 29 février
  /// d'origine. null : l'échéance sert d'ancre. Remis à null quand l'utilisateur change l'échéance ou la règle.
  recurrenceAnchor DateTime? @map("recurrence_anchor") @db.Date
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  listId String   @map("list_id")
  list   TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)

  /// Tâche dont celle-ci est une sous-tâche, dans la même liste ; un seul niveau. null : tâche de la liste.
  /// Supprimer la tâche supprime ses sous-tâches (elles en font partie).
  parentId String? @map("parent_id")
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  @@index([listId])
  @@index([parentId])
  @@index([completedById])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Événements
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(uuid(7))
  title       String
  description String?   @db.Text
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  coverUrl    String?   @map("cover_url")
  /// Teinte choisie par l'utilisateur (la valeur par défaut vient des tokens côté interface).
  color       String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Propriétaire. null : il a supprimé son compte ; un co-organisateur peut reprendre la propriété, sinon un job
  /// planifié supprime l'événement 48 h après `ownerLeftAt`. Le service de suppression de compte renseigne
  /// `ownerLeftAt` dans la même transaction que la suppression (la clé étrangère met `ownerId` à null).
  ownerId     String?   @map("owner_id")
  owner       User?     @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerLeftAt DateTime? @map("owner_left_at")
  /// null = événement personnel et privé (ADR 0009).
  spaceId     String?   @map("space_id")
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  participants    EventParticipant[]
  settings        EventSettings?
  invites         Invite[]
  proposedInvites ProposedInvite[]
  notifications   Notification[]
  comments        Comment[]

  @@index([spaceId, startDate])
  @@index([ownerId])
  @@index([startDate])
  @@index([ownerLeftAt])
  @@map("events")
}

model EventParticipant {
  id       String            @id @default(uuid(7))
  role     EventRole         @default(GUEST)
  status   ParticipantStatus @default(PENDING)
  joinedAt DateTime          @default(now()) @map("joined_at")

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_participants")
}

model EventSettings {
  id                 String  @id @default(uuid(7))
  /// Les invités peuvent voir qui vient.
  isGuestListVisible Boolean @default(true) @map("is_guest_list_visible")
  /// true : un invité invite directement ; false : il passe par une proposition.
  allowGuestInvite   Boolean @default(false) @map("allow_guest_invite")
  /// null = illimité.
  maxParticipants    Int?    @map("max_participants")

  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

// ---------------------------------------------------------------------------
// Invitations
// ---------------------------------------------------------------------------

/// Invitation officielle (envoyée par un organisateur, ou issue d'une proposition validée).
model Invite {
  id        String       @id @default(uuid(7))
  /// Jeton du lien d'accès.
  token     String       @unique
  /// L'invité n'a pas forcément de compte.
  /// @pii identité fin-de-l'événement
  email     String
  status    InviteStatus @default(PENDING)
  /// Rôle que la personne aura si elle accepte.
  role      EventRole    @default(GUEST)
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  eventId   String  @map("event_id")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId String  @map("inviter_id")
  inviter   User    @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  /// Renseigné si l'invité a déjà un compte.
  userId    String? @map("user_id")
  user      User?   @relation("InviteReceiver", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([inviterId])
  @@index([userId])
  @@map("invites")
}

model ProposedInvite {
  id             String         @id @default(uuid(7))
  /// @pii identité fin-de-l'événement
  suggestedEmail String?        @map("suggested_email")
  reason         String?
  status         ProposalStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  eventId    String @map("event_id")
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposerId String @map("proposer_id")
  proposer   User   @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([proposerId])
  @@map("proposed_invites")
}

// ---------------------------------------------------------------------------
// Notifications et commentaires
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid(7))
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  /// Contenu propre au type, validé par un schéma Zod versionné (`schemaVersion`) à l'écriture et à la lecture.
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  /// Destinataire.
  userId  String  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([eventId])
  @@map("notifications")
}

model Comment {
  id          String   @id @default(uuid(7))
  text        String   @db.Text
  /// Un commentaire important notifie les inscrits (CONTEXT.md).
  isImportant Boolean  @default(false) @map("is_important")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Amis (deviendra « Contact », voir CONTEXT.md)
// ---------------------------------------------------------------------------

model Friendship {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now()) @map("created_at")

  userId   String @map("user_id")
  user     User   @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId String @map("friend_id")
  friend   User   @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}
