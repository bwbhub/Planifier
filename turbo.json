{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@planifier/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "@planifier/db#generate"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "@planifier/db#generate"]
    },
    "test": {
      "dependsOn": ["^test", "@planifier/db#generate"]
    },
    "test:integration": {
      "dependsOn": ["^test:integration", "@planifier/db#generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "MAILPIT_URL", "CI"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["@planifier/db#generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "seed": {
      "dependsOn": ["^seed", "@planifier/db#generate"],
      "cache": false
    }
  }
}
